@model List<MyCourseVM>
@{
    ViewData["Title"] = "My Courses";
    string status = ViewBag.Status ?? "";
}

<div class="page-head">
    <h1>My Courses</h1>
    <p>Your enrollments, completions and certificates.</p>
</div>

<div class="mb-3 d-inline-flex flex-wrap gap-1" style="background:#EEF2F7; border-radius:14px; padding:4px;">
    @foreach (var t in new[] { "", "Enrolled", "Completed", "Withdrawn" })
    {
        var active = status == t;
        <a asp-action="MyCourses" asp-route-status="@t"
           class="btn btn-sm @(active ? "btn-white shadow-sm fw-bold" : "btn-link text-decoration-none text-muted fw-semibold")"
           style="@(active ? "background:#fff;color:#1E64D3;border-radius:11px;" : "border-radius:11px;")">
            @(string.IsNullOrEmpty(t) ? "All" : t)
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="card-soft"><div class="empty-state">
        <i class="bi bi-mortarboard"></i>
        <h5 class="mt-3">No courses in this section.</h5>
        <p><a asp-action="Courses" class="text-brand fw-semibold">Browse available courses</a></p>
    </div></div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card-soft h-100"><div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="fw-bold">@c.CourseName</div>
                        <span class="chip @(c.Status == "Completed" ? "chip-green" : c.Status == "Withdrawn" ? "chip-red" : "chip-blue")">@c.Status</span>
                    </div>
                    <div class="small text-muted mt-1"><i class="bi bi-building me-1"></i>@c.CompanyName</div>
                    <div class="small text-muted mt-2">
                        <div><i class="bi bi-calendar-range me-1"></i>@c.StartDate — @c.EndDate</div>
                        <div><i class="bi bi-clock me-1"></i>@c.ClassTimings</div>
                    </div>
                    <div class="mt-auto pt-3">
                        @if (c.CertificateId.HasValue)
                        {
                            <a asp-action="Certificate" asp-route-id="@c.CertificateId" class="btn btn-primary w-100">
                                <i class="bi bi-award me-1"></i>View certificate
                            </a>
                        }
                        else if (c.Status == "Enrolled")
                        {
                            <form asp-action="Withdraw" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="enrollmentId" value="@c.EnrollmentId" />
                                <button type="submit" class="btn btn-outline-danger w-100"
                                        onclick="return confirm('Withdraw from this course?');">
                                    <i class="bi bi-box-arrow-right me-1"></i>Withdraw
                                </button>
                            </form>
                        }
                    </div>
                </div></div>
            </div>
        }
    </div>
}
