@model List<InterviewRequestVM>
@{
    ViewData["Title"] = "Accepted Interviews";
}

<div class="page-head">
    <h1>Accepted Interviews</h1>
    <p>Interviews you accepted. Await the client to send a formal job offer.</p>
</div>

@if (!Model.Any())
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-calendar-check"></i>
            <h5 class="mt-3">Nothing here yet</h5>
            <p>Interviews you accept will be listed here.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in Model)
        {
            var pic = FypWeb.Helpers.ViewHelpers.Pic(r.OtherPartyPicture);
            <div class="col-md-6 col-xl-4">
                <div class="card-soft h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex gap-3">
                            @if (pic != null)
                            {
                                <img src="@pic" class="avatar-round" alt="@r.OtherPartyName" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                                <div class="avatar-round-fallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(r.OtherPartyName)</div>
                            }
                            else
                            {
                                <div class="avatar-round-fallback">@FypWeb.Helpers.ViewHelpers.Initial(r.OtherPartyName)</div>
                            }
                            <div class="flex-grow-1">
                                @if (r.OtherPartyId > 0)
                                {
                                    <a asp-controller="Home" asp-action="ClientProfile" asp-route-id="@r.OtherPartyId"
                                       class="fw-bold text-decoration-underline d-block" style="color:#1E64D3;">@r.OtherPartyName</a>
                                }
                                else
                                {
                                    <div class="fw-bold">@r.OtherPartyName</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(r.OtherPartyPhone))
                                {
                                    <div class="text-muted small"><i class="bi bi-telephone me-1 text-brand"></i>@r.OtherPartyPhone</div>
                                }
                                <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@r.Location</div>
                                <div class="text-muted small"><i class="bi bi-clock me-1"></i>@r.Time</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <span class="chip chip-blue">@r.JobType</span>
                                    @if (r.JobType == "Part-Time" && !string.IsNullOrEmpty(r.SlotStart))
                                    {
                                        <span class="chip chip-gray">@r.SlotStart – @r.SlotEnd</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (r.SelectedSkills != null && r.SelectedSkills.Any())
                        {
                            <div class="mt-3 pt-2 border-top">
                                <div class="text-muted" style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;">Selected Skills</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var sk in r.SelectedSkills)
                                    {
                                        <span class="badge rounded-pill" style="background:#EFF6FF;color:#1D4ED8;border:1px solid #DBEAFE;font-weight:600;">
                                            @sk
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        @if (r.IsExclusive && r.JobType == "Full-Time")
                        {
                            <div class="alert py-2 px-3 small mt-3 mb-0" style="background:#FFF7ED;border:1px solid #FDBA74;color:#7C2D12;border-radius:10px;">
                                <div class="fw-bold" style="color:#9A3412;"><i class="bi bi-lock-fill me-1"></i>Exclusive full-time request</div>
                                <div class="mt-1">The restriction starts only if the client confirms hiring.</div>
                            </div>
                        }
                        <div class="mt-auto pt-3">
                            <div class="alert alert-info py-2 small mb-2"><i class="bi bi-hourglass-split me-1"></i>Awaiting client's job offer.</div>
                            <form asp-action="DecideInterview" method="post" onsubmit="return confirm('Withdraw your acceptance and reject this interview?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.InterviewId" />
                                <input type="hidden" name="decision" value="Rejected" />
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-x-lg me-1"></i>Withdraw Acceptance</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
