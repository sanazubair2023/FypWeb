@model List<WorkerCourseCardVM>
@{
    ViewData["Title"] = "Browse Courses";
    var search = ViewBag.Search as string ?? "";
}

<div class="page-head">
    <h1>Browse Courses</h1>
    <p>Company training courses open for enrollment.</p>
</div>

<div class="card-soft mb-3">
    <div class="card-body">
        <form method="get" asp-action="Courses" class="d-flex gap-2">
            <input type="text" name="search" value="@search" class="form-control" placeholder="Search by course name or description…" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a asp-action="Courses" class="btn btn-outline-secondary">Clear</a>
            }
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-mortarboard"></i>
            <h5 class="mt-3">No courses available</h5>
            <p>No open courses match your search right now — check back later.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card-soft h-100 d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-start gap-3">
                            <div class="wdk-course-icon"><i class="bi bi-mortarboard"></i></div>
                            <div class="flex-grow-1">
                                <div class="fw-bold">@c.CourseName</div>
                                <div class="small text-muted"><i class="bi bi-building me-1"></i>@c.CompanyName</div>
                            </div>
                            @if (!string.IsNullOrEmpty(c.EnrollmentStatus))
                            {
                                <span class="chip @(c.EnrollmentStatus == "Completed" ? "chip-green" : c.EnrollmentStatus == "Withdrawn" ? "chip-red" : "chip-blue")">@c.EnrollmentStatus</span>
                            }
                        </div>
                        <div class="small text-muted mt-3">
                            <div><i class="bi bi-calendar-range me-1"></i>@c.StartDate — @c.EndDate</div>
                            <div><i class="bi bi-clock me-1"></i>@c.ClassTimings</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.Description))
                        {
                            <p class="small text-muted mt-2 mb-0">@(c.Description.Length > 140 ? c.Description.Substring(0, 140) + "…" : c.Description)</p>
                        }
                        <div class="mt-auto pt-3">
                            @if (string.IsNullOrEmpty(c.EnrollmentStatus))
                            {
                                <form asp-action="Enroll" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="courseId" value="@c.CourseId" />
                                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-circle me-1"></i>Enroll now</button>
                                </form>
                            }
                            else
                            {
                                <a asp-action="MyCourses" class="btn btn-outline-secondary w-100 disabled">Already enrolled</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Styles {
    <style>
        .wdk-course-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            background: #EAF3FF;
            color: #1565C0;
            display: grid;
            place-items: center;
            font-size: 1.3rem;
            flex: 0 0 auto;
        }
    </style>
}
