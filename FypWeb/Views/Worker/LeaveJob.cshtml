@model ActiveJobVM
@{
    ViewData["Title"] = "Leave Job";
}

<div class="page-head">
    <h1>Leave Job</h1>
    <p>Submit a seven-day resignation notice for your current engagement.</p>
</div>

@if (Model == null)
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-door-open"></i><h5 class="mt-3">No active job available for resignation</h5>
            <p>If you already submitted notice, open Notifications to follow its acceptance and review status.</p>
            <a asp-action="Notifications" class="btn btn-outline-primary btn-sm"><i class="bi bi-bell me-1"></i>Open Notifications</a>
        </div>
    </div>
}
else
{
    <div class="row g-3 justify-content-center">
        <div class="col-lg-7">
            <div class="card-soft">
                <div class="card-body">
                    <div class="alert alert-light border">
                        <div class="fw-bold"><i class="bi bi-person-workspace me-1 text-brand"></i>@Model.ClientName</div>
                        <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@Model.Address</div>
                        @if (!string.IsNullOrWhiteSpace(Model.JobType))
                        {
                            <span class="chip chip-blue mt-2">@Model.JobType</span>
                        }
                    </div>
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>Your proposed last working day is seven days after submission. The client can accept earlier; otherwise it is accepted automatically when the notice ends. You review the client only after acceptance.
                    </div>
                    <form asp-action="LeaveJob" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="interviewId" value="@Model.InterviewId" />
                        <label for="resignationReason" class="form-label fw-semibold">Reason for leaving</label>
                        <textarea id="resignationReason" name="resignationReason" class="form-control" rows="4" minlength="1" maxlength="4000" placeholder="Explain why you're resigning" required></textarea>
                        <button type="submit" class="btn btn-danger w-100 mt-3" onclick="return confirm('Submit this seven-day resignation notice?');">
                            <i class="bi bi-box-arrow-right me-1"></i>Submit Resignation Notice
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
