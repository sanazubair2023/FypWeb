@model ActiveJobVM
@{
    ViewData["Title"] = "Leave Job";
}

<div class="page-head">
    <h1>Leave Job</h1>
    <p>Submit a resignation for your current engagement.</p>
</div>

@if (Model == null)
{
    <div class="card-soft"><div class="empty-state">
        <i class="bi bi-door-open"></i>
        <h5 class="mt-3">No active job</h5>
        <p>You don't currently have an active job to resign from.</p>
    </div></div>
}
else
{
    <div class="row g-3 justify-content-center">
        <div class="col-lg-7">
            <div class="card-soft"><div class="card-body">
                <div class="alert alert-light border">
                    <div class="fw-bold"><i class="bi bi-person-workspace me-1 text-brand"></i>@Model.ClientName</div>
                    <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@Model.Address</div>
                </div>

                <form asp-action="LeaveJob" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="interviewId" value="@Model.InterviewId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason for leaving</label>
                        <textarea name="resignationReason" class="form-control" rows="3" placeholder="Explain why you're resigning" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Last working date</label>
                        <input type="date" name="lastWorkingDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")" required />
                    </div>

                    <hr />
                    <h6 class="fw-bold">Rate your employer (optional)</h6>
                    <div class="mb-3 text-center">
                        <div class="rating-input">
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" name="rating" id="lr@(i)" value="@i" />
                                <label for="lr@(i)"><i class="bi bi-star-fill"></i></label>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comment (optional)</label>
                        <textarea name="comment" class="form-control" rows="2" placeholder="Share your experience"></textarea>
                    </div>

                    <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Submit your resignation?');">
                        <i class="bi bi-box-arrow-right me-1"></i>Submit Resignation
                    </button>
                </form>
            </div></div>
        </div>
    </div>
}
