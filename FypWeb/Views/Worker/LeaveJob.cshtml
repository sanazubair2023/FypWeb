@model ActiveJobVM
@{
    ViewData["Title"] = "Leave Job";
    var allJobs = ViewBag.AllActiveJobs as List<ActiveJobVM> ?? new List<ActiveJobVM>();
}

<div class="page-head">
    <h1>Leave Job</h1>
    <p>Submit or track a 7-day resignation notice for an active engagement.</p>
</div>

@if (Model == null)
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-door-open"></i>
            <h5 class="mt-3">No active job found</h5>
            <p>If your resignation was already accepted, open Notifications or your Dashboard to leave a client review.</p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-action="Notifications" class="btn btn-outline-primary btn-sm"><i class="bi bi-bell me-1"></i>Open Notifications</a>
                <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Dashboard</a>
            </div>
        </div>
    </div>
}
else
{
    @if (allJobs.Count > 1)
    {
        <div class="card-soft mb-3">
            <div class="card-body py-2">
                <div class="small fw-bold text-muted mb-2">SELECT ACTIVE CONTRACT (@allJobs.Count)</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var job in allJobs)
                    {
                        var active = job.InterviewId == Model.InterviewId;
                        <a asp-action="LeaveJob" asp-route-interviewId="@job.InterviewId"
                           class="btn btn-sm rounded-pill @(active ? "btn-primary" : "btn-outline-secondary")">
                            @job.ClientName (@job.JobType)
                            @if (job.IsResignationPending)
                            {
                                <span class="badge bg-warning text-dark ms-1">Notice Active</span>
                            }
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row g-3 justify-content-center">
        <div class="col-lg-7">
            <div class="card-soft">
                <div class="card-body">
                    <div class="alert alert-light border">
                        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                            <div class="fw-bold"><i class="bi bi-person-workspace me-1 text-brand"></i>@Model.ClientName</div>
                            @if (!string.IsNullOrWhiteSpace(Model.JobType))
                            {
                                <span class="chip chip-blue">@Model.JobType</span>
                            }
                        </div>
                        <div class="text-muted small mt-1"><i class="bi bi-geo-alt me-1"></i>@Model.Address</div>
                    </div>

                    @if (Model.IsResignationPending)
                    {
                        <div class="p-3 rounded-3 mb-3" style="background:#FFFBEB;border:1px solid #FDE68A;">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold" style="color:#92400E;">
                                    <i class="bi bi-hourglass-split me-1"></i>7-Day Resignation Notice Active
                                </span>
                                <span class="chip chip-amber">Notice Pending</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.NoticeEndsAt))
                            {
                                <div class="small text-dark">
                                    Auto-acceptance scheduled at: <strong>@Model.NoticeEndsAt</strong>
                                </div>
                            }
                        </div>

                        <div class="alert alert-info small mb-0">
                            <i class="bi bi-info-circle me-1"></i>Once @Model.ClientName accepts your resignation (or the 7-day notice expires automatically), you will be notified to submit your closing review.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info small">
                            <i class="bi bi-info-circle me-1"></i>Your proposed last working day is 7 days after submission. The client can accept earlier; otherwise it is accepted automatically when the notice ends. You review the client after acceptance.
                        </div>
                        <form asp-action="LeaveJob" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="interviewId" value="@Model.InterviewId" />
                            <label for="resignationReason" class="form-label fw-semibold">Reason for leaving <span class="text-danger">*</span></label>
                            <textarea id="resignationReason" name="resignationReason" class="form-control" rows="4" minlength="1" maxlength="4000" placeholder="Explain why you're resigning" required></textarea>
                            <button type="submit" class="btn btn-danger w-100 mt-3" onclick="return confirm('Submit this 7-day resignation notice?');">
                                <i class="bi bi-box-arrow-right me-1"></i>Submit Resignation Notice
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}
