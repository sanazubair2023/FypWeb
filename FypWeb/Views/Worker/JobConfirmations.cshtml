@model List<InterviewRequestVM>
@{
    ViewData["Title"] = "Job Offers";
    int? highlightHiringId = ViewBag.HighlightHiringId as int?;
}

<div class="page-head">
    <h1>Job Offers</h1>
    <p>Formal offers from clients. Accept to move toward being hired.</p>
</div>

@if (!Model.Any())
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-briefcase"></i>
            <h5 class="mt-3">No job offers</h5>
            <p>When a client sends you a job offer, it will appear here.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in Model)
        {
            var pic = FypWeb.Helpers.ViewHelpers.Pic(r.OtherPartyPicture);
            bool isHighlighted = r.IsHighlighted || (highlightHiringId.HasValue && highlightHiringId.Value == r.HiringId);
            bool isEnded = r.Status == "Terminated" || r.Status == "Resigned" || r.Status == "Completed";
            string badge; string badgeClass; string msg;
            if (r.HiringWorkerDecision == "Rejected") { badge = "Declined"; badgeClass = "chip-red"; msg = "You declined this offer."; }
            else if (r.Status == "Terminated") { badge = "Terminated"; badgeClass = "chip-red"; msg = "This contract was terminated."; }
            else if (r.Status == "Resigned") { badge = "Resigned"; badgeClass = "chip-amber"; msg = "This contract ended by resignation."; }
            else if (r.HiringDecision == "Accepted" || r.Status == "Finalized") { badge = "Hired"; badgeClass = "chip-green"; msg = "Congratulations! You are officially hired."; }
            else if (r.HiringWorkerDecision == "Accepted") { badge = "Accepted"; badgeClass = "chip-blue"; msg = "Offer accepted. Awaiting client's final confirmation."; }
            else { badge = "New Offer"; badgeClass = "chip-amber"; msg = "You've received a job offer!"; }
            <div class="col-md-6">
                <div class="card-soft h-100" style="@(isHighlighted ? "border:2px solid #2563EB;box-shadow:0 0 0 4px rgba(37,99,235,.10);" : "")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex gap-3">
                            @if (pic != null)
                            {
                                <img src="@pic" class="avatar-round" alt="@r.OtherPartyName" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                                <div class="avatar-round-fallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(r.OtherPartyName)</div>
                            }
                            else
                            {
                                <div class="avatar-round-fallback">@FypWeb.Helpers.ViewHelpers.Initial(r.OtherPartyName)</div>
                            }
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    @if (r.OtherPartyId > 0)
                                    {
                                        <a asp-controller="Home" asp-action="ClientProfile" asp-route-id="@r.OtherPartyId"
                                           class="fw-bold text-decoration-underline" style="color:#1E64D3;">@r.OtherPartyName</a>
                                    }
                                    else
                                    {
                                        <span class="fw-bold">@r.OtherPartyName</span>
                                    }
                                    <span class="chip @badgeClass">@badge</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(r.OtherPartyPhone))
                                {
                                    <div class="text-muted small"><i class="bi bi-telephone me-1 text-brand"></i>@r.OtherPartyPhone</div>
                                }
                                <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@r.Location</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <span class="chip chip-blue">@r.JobType</span>
                                    @if (r.JobType == "Part-Time" && !string.IsNullOrEmpty(r.SlotStart))
                                    {
                                        <span class="chip chip-gray"><i class="bi bi-clock me-1"></i>@r.SlotStart – @r.SlotEnd</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (r.SelectedSkills != null && r.SelectedSkills.Any())
                        {
                            <div class="mt-3 pt-2 border-top">
                                <div class="text-muted" style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;">Contract Skills</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var sk in r.SelectedSkills)
                                    {
                                        <span class="badge rounded-pill" style="background:#EFF6FF;color:#1D4ED8;border:1px solid #DBEAFE;font-weight:600;">
                                            @sk
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        @if (r.IsExclusive && r.JobType == "Full-Time")
                        {
                            <div class="alert py-2 px-3 small mt-3 mb-0" style="background:#FFF7ED;border:1px solid #FDBA74;color:#7C2D12;border-radius:10px;">
                                <div class="fw-bold" style="color:#9A3412;"><i class="bi bi-lock-fill me-1"></i>Exclusive full-time offer</div>
                                <div class="mt-1">If you accept and the client confirms this offer, your profile goes offline until resignation submission or termination.</div>
                            </div>
                        }

                        <div class="mt-auto pt-3">
                            <div class="alert alert-light border py-2 small mb-2">@msg</div>
                            @if (badge == "New Offer")
                            {
                                <div class="d-flex gap-2">
                                    <form asp-action="RespondJobOffer" method="post" class="flex-grow-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="interviewId" value="@r.InterviewId" />
                                        <input type="hidden" name="hiringId" value="@r.HiringId" />
                                        <input type="hidden" name="decision" value="Accepted" />
                                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2 me-1"></i>Accept Offer</button>
                                    </form>
                                    <form asp-action="RespondJobOffer" method="post" class="flex-grow-1" onsubmit="return confirm('Decline this job offer?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="interviewId" value="@r.InterviewId" />
                                        <input type="hidden" name="hiringId" value="@r.HiringId" />
                                        <input type="hidden" name="decision" value="Rejected" />
                                        <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-x-lg me-1"></i>Decline</button>
                                    </form>
                                </div>
                            }
                            else if (isEnded)
                            {
                                <a asp-action="ContractSummary" asp-route-interviewId="@r.InterviewId" class="btn btn-outline-secondary btn-sm w-100">
                                    <i class="bi bi-file-earmark-text me-1"></i>View Contract Exit Summary
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
