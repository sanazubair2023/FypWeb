@model EditWorkerProfileVM
@{
    ViewData["Title"] = "Edit Profile";
    var pic = FypWeb.Helpers.ViewHelpers.Pic(Model.CurrentPicture);
    var habits = ViewBag.AllHabits as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var selectedHabits = Model.HabitIds?.ToHashSet() ?? new HashSet<int>();
}

<div class="page-head d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div>
        <h1>Edit Profile</h1>
        <p class="text-muted mb-0">Update your details, skills and habits. Photo and password are optional.</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card-soft">
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form asp-action="EditProfile" method="post" enctype="multipart/form-data" id="editForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SkillsJson" id="skillsJson" />
                    <input type="hidden" asp-for="ExperiencesJson" id="experiencesJson" />

                    <div class="text-center mb-4">
                        @if (pic != null)
                        {
                            <img src="@pic" class="detail-avatar mb-2" alt="Current photo" id="photoPreview"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                            <div class="detail-avatar-fallback mb-2 mx-auto" id="photoFallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(Model.Name)</div>
                        }
                        else
                        {
                            <div class="detail-avatar-fallback mb-2 mx-auto" id="photoFallback">@FypWeb.Helpers.ViewHelpers.Initial(Model.Name)</div>
                            <img src="" class="detail-avatar mb-2" alt="" id="photoPreview" style="display:none;" />
                        }
                        <div>
                            <label class="btn btn-sm btn-outline-primary mb-0" for="PictureFile">
                                <i class="bi bi-camera me-1"></i>Change photo
                            </label>
                            <input asp-for="PictureFile" type="file" accept=".jpg,.jpeg,.png" class="d-none" id="PictureFile" />
                            <div class="form-text mt-1">Leave unchanged to keep your current photo (.jpg / .png).</div>
                        </div>
                    </div>

                    <!-- ── Fundamental details ── -->
                    <h6 class="fw-bold"><i class="bi bi-person me-1 text-brand"></i>Personal Details</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Your full name" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cnic" class="form-label fw-semibold">CNIC</label>
                            <input asp-for="Cnic" class="form-control" disabled readonly />
                            <div class="form-text">CNIC is your login ID and cannot be changed.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone No <span class="text-danger">*</span></label>
                            <input asp-for="Phone" type="tel" class="form-control" placeholder="03XXXXXXXXX" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-semibold">Address <span class="text-danger">*</span></label>
                            <input asp-for="Address" class="form-control" placeholder="House / street / area" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Age" class="form-label fw-semibold">Age</label>
                            <input asp-for="Age" type="number" min="18" max="90" class="form-control" placeholder="e.g. 30" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Salary" class="form-label fw-semibold">Expected Salary (Rs.)</label>
                            <input asp-for="Salary" type="number" min="0" step="0.01" class="form-control" placeholder="e.g. 25000" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label fw-semibold">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Bio" class="form-label fw-semibold">Short Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="2" placeholder="Tell clients about yourself"></textarea>
                    </div>

                    <!-- ── Skills & experience (separate screen, RN AddSkillScreen) ── -->
                    <hr class="my-4" />
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="fw-bold mb-1"><i class="bi bi-shapes me-1 text-brand"></i>Skills &amp; Experience <span class="text-danger">*</span></h6>
                            <div class="small text-muted" id="skillsSummary">No skills added yet — at least one sub-skill is required.</div>
                        </div>
                        <a href="/Account/AddSkills?returnTo=workerEdit" class="btn btn-outline-primary btn-sm" id="btnAddSkills">
                            <i class="bi bi-pencil-square me-1"></i>Edit Skills &amp; Experience
                        </a>
                    </div>

                    <!-- ── Habits ── -->
                    <hr class="my-4" />
                    <h6 class="fw-bold"><i class="bi bi-stars me-1 text-brand"></i>Habits &amp; Traits</h6>
                    <p class="form-text mt-0">Untick everything to clear your habits, or tick the ones that apply.</p>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var h in habits)
                        {
                            <label class="chip chip-blue" style="cursor:pointer;">
                                <input type="checkbox" name="HabitIds" value="@h.HabitId" class="form-check-input me-1"
                                @(selectedHabits.Contains(h.HabitId) ? "checked" : "") />@h.Name
                            </label>
                        }
                    </div>

                    <!-- ── Password ── -->
                    <hr class="my-4" />
                    <h6 class="fw-bold"><i class="bi bi-shield-lock me-1 text-brand"></i>Password</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">New Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Leave blank to keep current" autocomplete="new-password" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat new password" autocomplete="new-password" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var STORE_KEY = 'fypAddSkills';

            // ── Photo preview ──
            var input = document.getElementById('PictureFile');
            var preview = document.getElementById('photoPreview');
            var fallback = document.getElementById('photoFallback');
            input.addEventListener('change', function () {
                if (input.files && input.files[0]) {
                    preview.src = URL.createObjectURL(input.files[0]);
                    preview.style.display = '';
                    fallback.style.display = 'none';
                }
            });

            // ── Skills & Experience round-trip with the Add Skills screen ──
            function readSkillsState() {
                try { return JSON.parse(sessionStorage.getItem(STORE_KEY) || 'null'); }
                catch (e) { return null; }
            }

            function syncSkillsFields() {
                var st = readSkillsState();
                var skillsField = document.getElementById('skillsJson');
                var expField = document.getElementById('experiencesJson');
                var summary = document.getElementById('skillsSummary');
                if (!st) return; // keep server-rendered values
                skillsField.value = JSON.stringify((st.skills || []).map(function (s) {
                    return { CategoryId: s.CategoryId, SkillsId: s.SkillsId };
                }));
                expField.value = JSON.stringify(st.experiences || []);
                var bits = [];
                if (st.primaryName) bits.push('Primary: <strong>' + st.primaryName + '</strong>');
                bits.push((st.skills || []).length + ' skill(s)');
                bits.push((st.experiences || []).length + ' experience(s)');
                if (summary) summary.innerHTML = bits.join(' · ');
            }

            document.getElementById('btnAddSkills').addEventListener('click', function () {
                // Seed the Add Skills screen with the form's current junction rows
                // (the server-rendered SkillsJson already carries names).
                var st = { primary: null, secondary: [], skills: [], experiences: [] };
                try {
                    st.skills = JSON.parse(document.getElementById('skillsJson').value || '[]');
                    st.experiences = JSON.parse(document.getElementById('experiencesJson').value || '[]');
                    if (st.skills.length) {
                        st.primary = st.skills[0].CategoryId;
                        st.primaryName = st.skills[0].CategoryName || '';
                        st.secondary = [];
                        st.skills.forEach(function (s) {
                            if (s.CategoryId !== st.primary && st.secondary.indexOf(s.CategoryId) < 0) st.secondary.push(s.CategoryId);
                        });
                    }
                } catch (e) { /* start blank */ }
                sessionStorage.setItem(STORE_KEY, JSON.stringify(st));
            });

            window.addEventListener('pageshow', syncSkillsFields);

            document.getElementById('editForm').addEventListener('submit', function (e) {
                var count = 0;
                try { count = (JSON.parse(document.getElementById('skillsJson').value || '[]') || []).length; }
                catch (err) { count = 0; }
                if (!count) {
                    e.preventDefault();
                    alert('Please add at least one sub-skill to proceed. Tap "Edit Skills & Experience".');
                }
            });

            // Initial summary from the server-rendered skills.
            (function initialSummary() {
                var summary = document.getElementById('skillsSummary');
                if (!summary) return;
                try {
                    var skills = JSON.parse(document.getElementById('skillsJson').value || '[]');
                    var exps = JSON.parse(document.getElementById('experiencesJson').value || '[]');
                    if (skills.length) {
                        var primary = skills[0].CategoryName || '';
                        summary.innerHTML = (primary ? 'Primary: <strong>' + primary + '</strong> · ' : '') +
                            skills.length + ' skill(s) · ' + exps.length + ' experience(s)';
                    }
                } catch (e) { }
            })();
        })();
    </script>
}
