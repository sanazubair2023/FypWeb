@model Fyp_Backend.Models.Termination
@{
    ViewData["Title"] = "Termination";
    bool alreadyReviewed = ViewBag.AlreadyReviewed ?? false;
    var client = Model?.Interview?.Client;
    var pic = FypWeb.Helpers.ViewHelpers.Pic(client?.Picture);
}

<div class="page-head">
    <h1>Termination</h1>
    <p>Details of the most recent contract termination.</p>
</div>

@if (Model == null)
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-shield-check"></i>
            <h5 class="mt-3">No terminations</h5>
            <p>You have no termination records. Keep up the great work!</p>
        </div>
    </div>
}
else
{
    <div class="row g-3 justify-content-center">
        <div class="col-lg-7">
            <div class="card-soft">
                <div class="card-body">
                    <div class="d-flex gap-3 align-items-center mb-3">
                        @if (pic != null)
                        {
                            <img src="@pic" class="avatar-round" alt="client" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                            <div class="avatar-round-fallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(client?.Name)</div>
                        }
                        else
                        {
                            <div class="avatar-round-fallback">@FypWeb.Helpers.ViewHelpers.Initial(client?.Name)</div>
                        }
                        <div>
                            <h5 class="fw-bold mb-0">@(client?.Name ?? "Client")</h5>
                            <span class="chip chip-red">Contract Terminated</span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6"><div class="p-2 bg-light rounded"><small class="text-muted d-block">Terminated on</small><strong>@(Model.TerminatedDate?.ToString("dd MMM yyyy") ?? "N/A")</strong></div></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason provided</label>
                        <div class="p-3 bg-light rounded">@(string.IsNullOrWhiteSpace(Model.TerminatedReason) ? "No reason provided." : Model.TerminatedReason)</div>
                    </div>

                    @{
                        var clientReview = ViewBag.ClientReview as FypWeb.ViewModels.ReviewVM;
                    }
                    @if (clientReview != null)
                    {
                        <h6 class="fw-bold mt-4"><i class="bi bi-chat-square-quote me-1 text-brand"></i>Client's review of you</h6>
                        <partial name="_ReviewCard" model="clientReview" />
                    }

                    @if (alreadyReviewed)
                    {
                        <div class="alert alert-secondary mb-0"><i class="bi bi-check-circle me-1"></i>You've already reviewed this client.</div>
                    }
                    else
                    {
                        <hr />
                        <h6 class="fw-bold">Leave a review for this client</h6>
                        <form asp-action="ReviewClient" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="interviewId" value="@Model.InterviewId" />
                            <div class="mb-3 text-center">
                                <div class="rating-input">
                                    @for (int i = 5; i >= 1; i--)
                                    {
                                        <input type="radio" name="rating" id="wr@(i)" value="@i" @(i == 3 ? "checked" : "") />
                                        <label for="wr@(i)"><i class="bi bi-star-fill"></i></label>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Comment (optional)</label>
                                <textarea name="comment" class="form-control" rows="3" maxlength="4000" placeholder="Share your experience"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-send me-1"></i>Submit Review</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}
