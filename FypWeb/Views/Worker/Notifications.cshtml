@model WorkerNotificationPageVM
@{
    ViewData["Title"] = "Notifications";
}

<div class="page-head d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h1>Notifications</h1>
        <p class="mb-0">Interview requests, job offers, resignations, and contract updates. <strong>@Model.UnreadCount unread</strong></p>
    </div>
    @if (Model.UnreadCount > 0)
    {
        <form asp-action="MarkAllNotificationsRead" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="snapshotAtUtc" value="@Model.SnapshotAtUtc.ToString("O")" />
            <input type="hidden" name="skip" value="@Model.Skip" />
            <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-check2-all me-1"></i>Mark all shown history read</button>
        </form>
    }
</div>

@if (!Model.Items.Any())
{
    <div class="card-soft"><div class="empty-state"><i class="bi bi-bell-slash"></i><h5 class="mt-3">No notifications</h5><p>New activity will appear here without removing older history.</p></div></div>
}
else
{
    <div class="d-grid gap-2">
        @foreach (var item in Model.Items)
        {
            <div class="card-soft notification-card @(item.IsRead ? "is-read" : "is-unread")">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <span class="notification-icon"><i class="bi @(item.Type switch { "interview" => "bi-envelope", "job" => "bi-briefcase", "termination" => "bi-exclamation-triangle", _ => "bi-bell" })"></i></span>
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <h6 class="fw-bold mb-0">@item.Title</h6>
                                @if (!item.IsRead)
                                {
                                    <span class="chip chip-blue">New</span>
                                }
                            </div>
                            <p class="text-muted small my-2">@item.Message</p>
                            <time class="small text-muted utc-time" datetime="@item.CreatedAtUtc.ToString("O")">@item.CreatedAtUtc.ToString("dd MMM yyyy HH:mm 'UTC'")</time>
                        </div>
                        <form asp-action="OpenNotification" method="post" class="ms-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="key" value="@item.Key" />
                            <input type="hidden" name="skip" value="@Model.Skip" />
                            <input type="hidden" name="snapshotAtUtc" value="@Model.SnapshotAtUtc.ToString("O")" />
                            <button type="submit" class="btn btn-sm @(item.DestinationUrl == null ? "btn-outline-secondary" : "btn-outline-primary")">
                                @(item.DestinationUrl == null ? (item.IsRead ? "No link" : "Mark read") : "Open")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        @if (Model.Skip > 0)
        {
            <a asp-action="Notifications" asp-route-skip="@Math.Max(0, Model.Skip - Model.Take)" asp-route-take="@Model.Take" asp-route-snapshotAtUtc="@Model.SnapshotAtUtc.ToString("O")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Newer</a>
        }
        else
        {

            <span></span>
        }
        <span class="small text-muted">Showing @Model.Items.Count item(s)</span>
        @if (Model.HasMore)
        {
            <a asp-action="Notifications" asp-route-skip="@(Model.Skip + Model.Take)" asp-route-take="@Model.Take" asp-route-snapshotAtUtc="@Model.SnapshotAtUtc.ToString("O")" class="btn btn-outline-secondary btn-sm">Older<i class="bi bi-arrow-right ms-1"></i></a>
        }
        else
        {

            <span></span>
        }
    </div>
}

@section Styles {
    <style>
        .notification-card.is-unread {
            border-color: #9DBDF5;
            background: #F7FAFF;
        }

        .notification-card.is-read {
            opacity: .88;
        }

        .notification-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #EAF3FF;
            color: #1E64D3;
            flex: 0 0 auto;
        }

        .min-w-0 {
            min-width: 0;
        }
    </style>
}

@section Scripts {
    <script>
        document.querySelectorAll('.utc-time').forEach(function (el) {
            var date = new Date(el.getAttribute('datetime'));
            if (!isNaN(date.getTime())) el.textContent = date.toLocaleString();
        });
    </script>
}
