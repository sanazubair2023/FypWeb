@model CertificateVM
@{
    ViewData["Title"] = "Verify Certificate";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
    bool searched = ViewBag.Searched == true;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-soft">
            <div class="card-body">
                <h5 class="fw-bold mb-3"><i class="bi bi-shield-check me-1 text-brand"></i>Verify a Course Certificate</h5>
                <form method="get" asp-action="VerifyCertificate" class="d-flex gap-2">
                    <input type="text" name="code" value="@Model.CertificateCode" class="form-control font-monospace"
                           placeholder="e.g. FYP-COURSE-1A2B3C4D5E6F" required />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Verify</button>
                </form>

                @if (searched)
                {
                    @if (Model.CertificateId > 0)
                    {
                        <div class="mt-4 rounded-3 p-3" style="background:@(Model.IsValid ? "#E7F7F0" : "#FDECEC");">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi @(Model.IsValid ? "bi-patch-check-fill" : "bi-exclamation-octagon-fill")"
                                   style="font-size:1.4rem;color:@(Model.IsValid ? "#16865C" : "#C62828");"></i>
                                <span class="fw-bold" style="font-size:1.05rem;color:@(Model.IsValid ? "#16865C" : "#C62828");">
                                    @(Model.IsValid ? "Valid certificate" : "Certificate REVOKED")
                                </span>
                            </div>
                            <hr />
                            <dl class="row mb-0 small">
                                <dt class="col-sm-4">Certificate code</dt>
                                <dd class="col-sm-8 font-monospace fw-bold">@Model.CertificateCode</dd>
                                <dt class="col-sm-4">Awarded to</dt>
                                <dd class="col-sm-8">@Model.WorkerName</dd>
                                <dt class="col-sm-4">Course</dt>
                                <dd class="col-sm-8">@Model.CourseName</dd>
                                <dt class="col-sm-4">Issued by</dt>
                                <dd class="col-sm-8">@Model.CompanyName</dd>
                                <dt class="col-sm-4">Issued on</dt>
                                <dd class="col-sm-8">@Model.IssuedDate</dd>
                            </dl>
                        </div>
                    }
                    else
                    {
                        <div class="mt-4 alert alert-danger mb-0">
                            <i class="bi bi-x-octagon-fill me-1"></i>
                            No certificate found for code <strong class="font-monospace">@Model.CertificateCode</strong>.
                            Check the code and try again.
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small mt-3 mb-0">
                        Enter the certificate code printed on a worker's digital certificate to confirm it is genuine.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
