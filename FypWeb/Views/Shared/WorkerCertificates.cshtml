@* RN Client/WorkerCertificationDetail.js — Unified list of Company Skill Certifications
   and Course Completion Certificates for a worker. *@
@model WorkerCertificateListVM
@{
    ViewData["Title"] = $"{Model.WorkerName} · Verified Certificates";
    var pic = FypWeb.Helpers.ViewHelpers.Pic(Model.WorkerPicture);
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
        @if (Model.ViewerRole == "Worker")
        {
            <a asp-controller="Worker" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
            </a>
        }
        else
        {
            <a asp-controller="Client" asp-action="WorkerDetail" asp-route-id="@Model.WorkerId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
            </a>
        }
        <div>
            <h1 class="h4 mb-0 fw-bold">Verified Training &amp; Certificates</h1>
            <small class="text-muted">@Model.Certificates.Count verified @(Model.Certificates.Count == 1 ? "record" : "records") for @Model.WorkerName</small>
        </div>
    </div>
    <a asp-controller="Home" asp-action="VerifyCertificate" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-qr-code-scan me-1"></i>Verify Certificate Code
    </a>
</div>

<!-- Worker Banner -->
<div class="card-soft mb-3">
    <div class="card-body d-flex align-items-center gap-3">
        @if (pic != null)
        {
            <img src="@pic" alt="@Model.WorkerName" style="width:54px;height:54px;border-radius:50%;object-fit:cover;"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
            <div class="wc-avatar-fallback" style="width:54px;height:54px;border-radius:50%;display:none;">@FypWeb.Helpers.ViewHelpers.Initial(Model.WorkerName)</div>
        }
        else
        {
            <div class="wc-avatar-fallback" style="width:54px;height:54px;border-radius:50%;">@FypWeb.Helpers.ViewHelpers.Initial(Model.WorkerName)</div>
        }
        <div class="flex-grow-1">
            <div class="fw-bold fs-5">@Model.WorkerName</div>
            <div class="text-muted small">Company-issued skill evaluations &amp; completed training courses</div>
        </div>
        <span class="chip chip-blue">
            <i class="bi bi-patch-check-fill"></i>@Model.Certificates.Count Total
        </span>
    </div>
</div>

@if (Model.Certificates.Count == 0)
{
    <div class="card-soft text-center py-5">
        <div class="card-body">
            <i class="bi bi-award text-muted" style="font-size:2.6rem;opacity:.5;"></i>
            <h2 class="h6 fw-bold mt-3">No Certificate Records Yet</h2>
            <p class="text-muted small mb-0">
                @(Model.ViewerRole == "Worker"
                    ? "Complete a company training course or receive a skill evaluation certificate to showcase it here."
                    : "This worker does not have any published training or skill certificates yet.")
            </p>
            @if (Model.ViewerRole == "Worker")
            {
                <a asp-controller="Worker" asp-action="Courses" class="btn btn-brand btn-sm mt-3">
                    <i class="bi bi-mortarboard me-1"></i>Browse Training Courses
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var cert in Model.Certificates)
        {
            bool isCourse = cert.CertificateType == "CourseCompletion";
            string detailUrl = Model.ViewerRole == "Worker"
                ? Url.Action("WorkerCertificateRecord", "Worker", new { type = cert.CertificateType, certId = cert.CertificateId })!
                : Url.Action("WorkerCertificateRecord", "Client", new { workerId = Model.WorkerId, type = cert.CertificateType, certId = cert.CertificateId })!;
            <div class="col-md-6">
                <div class="card-soft h-100 d-flex flex-column">
                    <div class="card-body d-flex flex-column flex-grow-1">
                        <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                            <span class="chip @(isCourse ? "chip-green" : "chip-blue")">
                                <i class="bi @(isCourse ? "bi-mortarboard-fill" : "bi-award-fill")"></i>
                                @(isCourse ? "Course Completion" : "Company Skill Certification")
                            </span>
                            <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@cert.IssuedDate</span>
                        </div>

                        <h3 class="h6 fw-bold mb-1">@cert.CertificateTitle</h3>
                        <div class="small text-muted mb-2">
                            <i class="bi bi-building me-1"></i>Issued by <strong>@cert.CompanyName</strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(cert.CertificateCode))
                        {
                            <div class="mb-2">
                                <span class="badge bg-light text-dark border font-monospace">
                                    <i class="bi bi-key me-1 text-primary"></i>@cert.CertificateCode
                                </span>
                            </div>
                        }

                        @{
                            var preview = !string.IsNullOrWhiteSpace(cert.EvaluationNotes)
                                ? cert.EvaluationNotes
                                : cert.CourseDescription;
                        }
                        @if (!string.IsNullOrWhiteSpace(preview))
                        {
                            <p class="small text-secondary mb-3" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @preview
                            </p>
                        }

                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                            @if (cert.DurationDays.HasValue)
                            {
                                <span class="small text-muted">
                                    <i class="bi bi-clock me-1"></i>@cert.DurationDays.Value @(cert.DurationDays.Value == 1 ? "day" : "days") course
                                </span>
                            }
                            else
                            {
                                <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i>Verified Record</span>
                            }
                            <a href="@detailUrl" class="btn btn-sm btn-outline-primary">
                                View Record <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
