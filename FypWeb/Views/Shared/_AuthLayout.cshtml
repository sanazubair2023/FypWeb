<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Maid &amp; Servant Online</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-wrap">
        <div class="auth-brand-side">
            <div class="auth-brand-inner">
                <span class="brand-mark lg"><i class="bi bi-house-heart-fill"></i></span>
                <h1>Maid &amp; Servant<br /><span>Online</span></h1>
                <p>Trusted domestic staffing — connect clients, verified workers, agencies and police verification in one platform.</p>
                <ul class="auth-points">
                    <li><i class="bi bi-check2-circle"></i> Police-verified character certificates</li>
                    <li><i class="bi bi-check2-circle"></i> Part-time &amp; full-time smart matching</li>
                    <li><i class="bi bi-check2-circle"></i> Company skill certifications</li>
                </ul>
            </div>
        </div>
        <div class="auth-form-side">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
