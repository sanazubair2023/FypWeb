@{
    var role = User?.GetRole() ?? "";
    var displayName = User?.GetDisplayName() ?? "User";
    var pic = User?.GetPicture() ?? "";
    string picSrc;
    if (string.IsNullOrWhiteSpace(pic)) picSrc = "";
    else if (pic.StartsWith("http")) picSrc = pic;
    else if (pic.StartsWith("/Images/") || pic.StartsWith("Images/")) picSrc = pic.StartsWith("/") ? pic : "/" + pic;
    else picSrc = "/Images/" + pic.TrimStart('/');
    var initials = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName.Trim()[0].ToString().ToUpper();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Maid &amp; Servant Online</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <span class="brand-mark"><i class="bi bi-house-heart-fill"></i></span>
                <span class="brand-text">Maid &amp; Servant<small>Online</small></span>
            </div>
            <nav class="sidebar-nav">
                @await Html.PartialAsync("_Sidebar")
            </nav>
            <div class="sidebar-foot">
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout"><i class="bi bi-box-arrow-left"></i><span>Logout</span></button>
                </form>
            </div>
        </aside>
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Main -->
        <div class="app-main">
            <header class="topbar">
                <button class="btn-hamburger" id="btnHamburger" type="button" aria-label="Toggle menu">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-title">@ViewData["Title"]</div>
                @if (role == "Worker")
                {
                    <a asp-controller="Worker" asp-action="Notifications" class="btn btn-link position-relative text-dark text-decoration-none ms-auto me-2" aria-label="Worker notifications">
                        <i class="bi bi-bell fs-5"></i>
                        <span id="workerNotificationBadge" data-notification-url="@Url.Action("NotificationUnreadCount", "Worker")" class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger d-none">0</span>
                    </a>
                }
                <div class="topbar-profile dropdown">
                    <button class="profile-btn dropdown-toggle" data-bs-toggle="dropdown" type="button" aria-expanded="false">
                        @if (!string.IsNullOrEmpty(picSrc))
                        {
                            <img src="@picSrc" alt="me" class="avatar-sm" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <span class="avatar-fallback" style="display:none;">@initials</span>
                        }
                        else
                        {
                            <span class="avatar-fallback">@initials</span>
                        }
                        <span class="profile-meta d-none d-sm-flex">
                            <span class="profile-name">@displayName</span>
                            <span class="profile-role">@role</span>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><span class="dropdown-item-text small text-muted">Signed in as <strong>@role</strong></span></li>
                        <li><hr class="dropdown-divider" /></li>
                        @if (role == "Client")
                        {
                            <li><a class="dropdown-item" asp-controller="Client" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                        }
                        @if (role == "Worker")
                        {
                            <li><a class="dropdown-item" asp-controller="Worker" asp-action="EditProfile"><i class="bi bi-person me-2"></i>Edit Profile</a></li>
                        }
                        @if (role == "Company")
                        {
                            <li><a class="dropdown-item" asp-controller="Company" asp-action="EditProfile"><i class="bi bi-person me-2"></i>Edit Profile</a></li>
                        }
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-left me-2"></i>Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main class="content-area">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
