@{
    ViewData["Title"] = "Access Denied";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="card-soft text-center p-4">
            <div class="mx-auto mb-3 d-grid" style="width:68px;height:68px;border-radius:50%;background:#FEF2F2;color:#DC2626;place-items:center;font-size:1.9rem;">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="h4 fw-bold mb-2">Access Denied</h1>
            <p class="text-muted mb-4">
                Your current account role does not have permission to open this page.
                @if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    <span class="d-block small mt-1 font-monospace text-secondary">@returnUrl</span>
                }
            </p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn btn-brand">
                    <i class="bi bi-house-door me-1"></i>Go to My Dashboard
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                    Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
