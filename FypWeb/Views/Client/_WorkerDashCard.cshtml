@model InterviewRequestVM
@{
    var pic = FypWeb.Helpers.ViewHelpers.Pic(Model.OtherPartyPicture);
    var isPast = Model.Status == "Resigned" || Model.Status == "Terminated" || Model.Status == "Completed";
    var caption = isPast ? "Contract closed" : "Working with you";
    var pill = Model.Status switch
    {
        "On Work" => "chip-green",
        "Pending Resignation" => "chip-amber",
        "Resigned" => "chip-amber",
        "Terminated" => "chip-red",
        _ => "chip-blue"
    };
}
<div class="col-md-6 col-xl-4">
    <div class="wdc">
        <div class="wdc-head">
            @if (pic != null)
            {
                <img src="@pic" class="wdc-avatar" alt="@Model.OtherPartyName"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                <div class="wdc-avatar-fb" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(Model.OtherPartyName)</div>
            }
            else
            {
                <div class="wdc-avatar-fb">@FypWeb.Helpers.ViewHelpers.Initial(Model.OtherPartyName)</div>
            }
            <div class="flex-grow-1">
                <div class="wdc-name">@Model.OtherPartyName</div>
                <div class="wdc-caption">@(string.IsNullOrWhiteSpace(Model.CategoryName) ? caption : $"{Model.CategoryName} · {caption}")</div>
            </div>
            <span class="chip @pill">@Model.Status</span>
        </div>

        <div class="wdc-chiprow">
            <span class="chip chip-blue"><i class="bi bi-briefcase me-1"></i>@Model.JobType</span>
            @if (Model.IsExclusive)
            {
                <span class="chip chip-amber"><i class="bi bi-lock me-1"></i>Exclusive</span>
            }
            @if (Model.JobType == "Part-Time" && !string.IsNullOrEmpty(Model.SlotStart))
            {
                <span class="chip chip-gray"><i class="bi bi-clock me-1"></i>@Model.SlotStart&nbsp;–&nbsp;@Model.SlotEnd</span>
            }
        </div>

        @if (Model.SelectedSkills != null && Model.SelectedSkills.Any())
        {
            <div class="d-flex flex-wrap gap-1 mb-2">
                @foreach (var sk in Model.SelectedSkills.Take(4))
                {
                    <span class="badge rounded-pill" style="background:#EFF6FF;color:#1D4ED8;border:1px solid #DBEAFE;font-weight:600;font-size:.7rem;">
                        @sk
                    </span>
                }
                @if (Model.SelectedSkills.Count > 4)
                {
                    <span class="badge rounded-pill bg-light text-muted border" style="font-size:.7rem;">+@(Model.SelectedSkills.Count - 4)</span>
                }
            </div>
        }

        <div class="wdc-loc">
            <i class="bi bi-geo-alt-fill"></i>
            <span class="text-truncate">@Model.Location</span>
        </div>

        @if (Model.HiringDate != null)
        {
            <div class="small text-muted mb-2"><i class="bi bi-calendar-check me-1"></i>Hired @Model.HiringDate</div>
        }
        <div class="wdc-divider"></div>

        <div class="wdc-foot">
            <span class="wdc-rid"><i class="bi bi-hash"></i>Record @Model.InterviewId</span>
            <div class="d-flex flex-wrap gap-1">
                <a asp-action="WorkerDetail" asp-route-id="@Model.OtherPartyId" class="btn btn-outline-primary btn-sm">Profile</a>
                @if (Model.Status == "On Work")
                {
                    <a asp-action="Terminate" asp-route-interviewId="@Model.InterviewId" class="btn btn-outline-danger btn-sm">Terminate</a>
                }
                @if (Model.ResignationId.HasValue && (Model.Status == "Pending Resignation" || Model.Status == "Resigned"))
                {
                    <a asp-action="ResignationDetail" asp-route-id="@Model.ResignationId" class="btn btn-outline-primary btn-sm">Resignation</a>
                }
                @if (isPast)
                {
                    <a asp-action="ContractSummary" asp-route-workerId="@Model.OtherPartyId" asp-route-interviewId="@Model.InterviewId" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-file-text me-1"></i>Summary
                    </a>
                }
            </div>
        </div>
    </div>
</div>
