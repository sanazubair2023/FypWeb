@model ResignationVM
@{
    ViewData["Title"] = "Resignation Detail";
    var pic = FypWeb.Helpers.ViewHelpers.Pic(Model.WorkerAvatar);
    int idx = 0;
}

<a asp-action="Resignations" class="btn btn-link px-0 mb-2 text-brand"><i class="bi bi-arrow-left me-1"></i>Back to resignations</a>

<div class="row g-3">
    <div class="col-lg-7">
        @* ── Resignation info ── *@
        <div class="card-soft mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    @if (pic != null)
                    {
                        <img src="@pic" class="avatar-round" alt="@Model.WorkerName" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                        <div class="avatar-round-fallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(Model.WorkerName)</div>
                    }
                    else
                    {
                        <div class="avatar-round-fallback">@FypWeb.Helpers.ViewHelpers.Initial(Model.WorkerName)</div>
                    }
                    <div class="flex-grow-1">
                        <div class="fw-bold">@Model.WorkerName</div>
                        <div class="text-muted small">Resignation submitted @Model.SubmittedDate</div>
                    </div>
                    <span class="chip @(Model.IsConfirmed ? "chip-green" : "chip-amber")">@(Model.IsConfirmed ? "Accepted" : "Notice pending")</span>
                </div>
                <hr />
                <dl class="row small mb-0">
                    <dt class="col-sm-4">Reason</dt>
                    <dd class="col-sm-8">@Model.Reason</dd>
                    <dt class="col-sm-4">Proposed last day</dt>
                    <dd class="col-sm-8">@Model.LastWorkingDate</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                    @if (Model.AcceptedAt != null)
                    {
                        <dt class="col-sm-4">Accepted</dt>
                        <dd class="col-sm-8">@Model.AcceptedAt (@Model.AcceptanceMode)</dd>
                    }
                </dl>
            </div>
        </div>

        @* ── The worker's own closing review ── *@
        @if (Model.WorkerReview != null)
        {
            <h6 class="fw-bold"><i class="bi bi-chat-square-quote me-1 text-brand"></i>Review from @Model.WorkerName</h6>
            <partial name="_ReviewCard" model="Model.WorkerReview" />
        }

        @* ── The client's review, locked after confirming ── *@
        @if (Model.IsConfirmed)
        {
            <h6 class="fw-bold mt-3"><i class="bi bi-chat-square-quote me-1 text-brand"></i>Your review</h6>
            @if (Model.ClientReview != null)
            {
                <partial name="_ReviewCard" model="Model.ClientReview" />
                <div class="small text-success mt-1"><i class="bi bi-lock me-1"></i>Locked — submitted with your confirmation.</div>
            }
            else
            {
                <div class="card-soft"><div class="card-body text-muted small">The closing review has not been submitted yet. Complete the review form on this page.</div></div>
            }
        }
    </div>

    @* ── Acceptance and/or criteria review input ── *@
    <div class="col-lg-5">
        @if (Model.ClientReview == null)
        {
            <div class="card-soft">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-clipboard-check me-1 text-brand"></i>@(Model.IsConfirmed ? "Complete your closing review" : "Accept resignation & leave a review")</h6>
                    <p class="text-muted small">@(Model.IsConfirmed ? "The resignation is already accepted. Rate every criterion and save your remarks; do not confirm it again." : "Accepting ends the contract immediately. Otherwise it is accepted automatically at the seven-day deadline.")</p>
                    @if (!Model.CriteriaGroups.Any())
                    {
                        <div class="alert alert-warning py-2 small"><i class="bi bi-info-circle me-1"></i>No review criteria are configured. Apply <code>Database/FypWeb_Parity_Upgrade.sql</code> before closing this review.</div>
                    }
                    else
                    {
                        <form asp-action="ConfirmResignation" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="interviewId" value="@Model.InterviewId" />
                            <input type="hidden" name="resignationId" value="@Model.ResignationId" />
                            <div class="fw-semibold small mb-2">Rate every criterion <span class="text-danger">*</span></div>
                            @foreach (var g in Model.CriteriaGroups)
                            {
                                <div class="crit-group-title">@g.GroupName</div>
                                foreach (var c in g.Items)
                                {
                                    <div class="crit-row">
                                        <input type="hidden" name="criteriaScores[@idx].CriteriaId" value="@c.CriteriaId" />
                                        <span class="crit-name">@c.Name</span>
                                        <span class="crit-stars" data-idx="@idx">
                                            @for (int score = 1; score <= 5; score++)
                                            {
                                                <input type="radio" class="d-none" name="criteriaScores[@idx].Score" value="@score" id="rs_@(idx)_@(score)" required="@(score == 1)" />
                                                <label for="rs_@(idx)_@(score)" class="crit-star" title="@score star@(score > 1 ? "s" : "")"><i class="bi bi-star"></i></label>
                                            }
                                        </span>
                                    </div>
                                    idx++;
                                }
                            }
                            <label class="form-label fw-semibold mt-3">Remarks <span class="text-danger">*</span></label>
                            <textarea name="comment" class="form-control" rows="3" maxlength="4000" placeholder="Your remarks about working with @Model.WorkerName" required></textarea>
                            <button type="submit" class="btn btn-primary w-100 mt-3" onclick="return confirm('@(Model.IsConfirmed ? "Save this closing review?" : "Accept this resignation and save your review?")');">
                                <i class="bi bi-check-lg me-1"></i>@(Model.IsConfirmed ? "Save Closing Review" : "Accept Resignation")
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card-soft">
                <div class="card-body text-center py-4">
                    <i class="bi bi-check-circle text-success" style="font-size:2rem;"></i>
                    <div class="fw-bold mt-2">Resignation accepted and reviewed</div>
                    <div class="text-muted small">This contract and both closing actions are complete.</div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .crit-group-title {
            margin-top: .75rem;
            margin-bottom: .375rem;
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: .6px;
            color: #1E64D3;
            text-transform: uppercase;
        }

        .crit-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            background: #F8FAFC;
            border: 1px solid #EDF1F7;
            border-radius: 10px;
            padding: .5rem .75rem;
            margin-bottom: .375rem;
        }

        .crit-name {
            font-size: .85rem;
            color: #333;
        }

        .crit-star {
            cursor: pointer;
            color: #D0D5DD;
            font-size: 1.15rem;
            margin-left: .15rem;
        }

            .crit-star.filled {
                color: #FFC107;
            }
    </style>
}

@section Scripts {
    <script>
        document.querySelectorAll('.crit-stars input[type="radio"]').forEach(function (r) {
            r.addEventListener('change', function () {
                var wrap = this.closest('.crit-stars');
                var val = parseInt(this.value, 10) || 0;
                wrap.querySelectorAll('.crit-star').forEach(function (lb, i) {
                    lb.classList.toggle('filled', i < val);
                    var ic = lb.querySelector('i');
                    if (ic) ic.className = (i < val) ? 'bi bi-star-fill' : 'bi bi-star';
                });
            });
        });
    </script>
}
