@model List<WorkerCardVM>
@{
    ViewData["Title"] = "Find a Worker";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var habits = ViewBag.Habits as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    string search = ViewBag.Search as string ?? "";
}

<div class="page-head">
    <h1>Find a Worker</h1>
    <p>Search verified domestic workers and filter by category, gender and traits.</p>
</div>

<div class="card-soft mb-4">
    <div class="card-body">
        <form method="get" asp-action="FindService" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold small">Search by name</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Worker name" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small">Category</label>
                <select name="categories" class="form-select">
                    <option value="All">All categories</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small">Gender</label>
                <select name="gender" class="form-select">
                    <option value="Both">Any</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small">City</label>
                <input type="text" name="city" class="form-control" placeholder="City" />
            </div>
            @if (habits.Any())
            {
                <div class="col-12">
                    <label class="form-label fw-semibold small d-block">Traits</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var h in habits)
                        {
                            <label class="chip chip-gray" style="cursor:pointer;">
                                <input type="checkbox" name="habitIds" value="@h.HabitId" class="form-check-input me-1" />@h.Name
                            </label>
                        }
                    </div>
                </div>
            }
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Apply Filters</button>
                <a asp-action="FindService" class="btn btn-outline-secondary">Reset</a>
                <a asp-action="Location" class="btn btn-outline-primary ms-auto"><i class="bi bi-geo-alt-fill me-1"></i>Map &amp; My Location</a>
            </div>
        </form>
    </div>
</div>

<p class="text-muted mb-3">@Model.Count worker(s) found.</p>

@if (!Model.Any())
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-search"></i>
            <h5 class="mt-3">No workers match your search</h5>
            <p>Try adjusting your filters.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var w in Model)
        {
            var pic = FypWeb.Helpers.ViewHelpers.Pic(w.Picture);
            <div class="col-md-6 col-xl-4">
                <div class="card-soft worker-card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="wc-top">
                            @if (pic != null)
                            {
                                <img src="@pic" class="wc-avatar" alt="@w.Name" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                                <div class="wc-avatar-fallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(w.Name)</div>
                            }
                            else
                            {
                                <div class="wc-avatar-fallback">@FypWeb.Helpers.ViewHelpers.Initial(w.Name)</div>
                            }
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold">@w.Name</span>
                                    @if (w.IsPoliceVerified)
                                    {
                                        <i class="bi bi-patch-check-fill text-brand" title="Police verified"></i>
                                    }
                                </div>
                                <div class="text-muted small">@w.Role</div>
                                <div class="stars mt-1"><i class="bi bi-star-fill"></i> <span class="text-dark fw-semibold">@w.Rating</span></div>
                            </div>
                        </div>
                        <div class="mt-3 small text-muted">
                            <div><i class="bi bi-geo-alt me-1"></i>@w.City</div>
                            <div><i class="bi bi-cash-coin me-1"></i>@w.Salary</div>
                            <div><i class="bi bi-gender-ambiguous me-1"></i>@w.Gender</div>
                        </div>
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            @foreach (var c in w.Categories.Take(3))
                            {
                                <span class="chip chip-blue">@c</span>
                            }
                        </div>
                        <div class="mt-auto pt-3">
                            <a asp-action="WorkerDetail" asp-route-id="@w.Id" class="btn btn-primary w-100">View Profile</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
