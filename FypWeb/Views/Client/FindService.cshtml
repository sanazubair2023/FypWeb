@model List<WorkerCardVM>
@{
    ViewData["Title"] = "Find a Worker";
    var search = ViewBag.Search as string ?? "";
    var q = Context.Request.Query;
    string gender = q["gender"].ToString();
    string city = q["city"].ToString();
    var cats = q["categories"].ToList();
    var subs = q["subSkills"].ToList();
    var habitsSel = ViewBag.Habits as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    bool anyFilter = !string.IsNullOrEmpty(gender) || !string.IsNullOrEmpty(city) || cats.Any() || subs.Any()
                     || q["habitIds"].Any();
}

<div class="page-head"><h1>Find a Worker</h1></div>

<div class="card-soft mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-center">
            <div class="col-md">
                <form method="get" asp-action="FindService" class="d-flex gap-2" id="searchForm">
                    @if (!string.IsNullOrEmpty(gender) && gender != "Both")
                    {
                        <input type="hidden" name="gender" value="@gender" />
                    }
                    @if (!string.IsNullOrEmpty(city))
                    {
                        <input type="hidden" name="city" value="@city" />
                    }
                    @foreach (var c in cats)
                    {
                        <input type="hidden" name="categories" value="@c" />
                    }
                    @foreach (var s in subs)
                    {
                        <input type="hidden" name="subSkills" value="@s" />
                    }
                    @foreach (var h in q["habitIds"])
                    {
                        <input type="hidden" name="habitIds" value="@h" />
                    }
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Search workers by name…" />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
                </form>
            </div>
            <div class="col-md-auto">
                <a class="btn btn-outline-primary"
                   href="@Url.Action("Filter", "Client", new { gender, city, categories = cats.ToArray(), subSkills = subs.ToArray(), habitIds = q["habitIds"].ToArray() })">
                    <i class="bi bi-funnel me-1"></i>Filter
                </a>
            </div>
        </div>

        @if (anyFilter)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                <span class="small text-muted fw-semibold">Active filters:</span>
                @if (!string.IsNullOrEmpty(gender))
                {
                    <span class="chip chip-blue">@gender <a href="#" class="text-decoration-none ms-1" data-clear="gender">&times;</a></span>
                }
                @if (!string.IsNullOrEmpty(city))
                {
                    <span class="chip chip-blue">@city <a href="#" class="text-decoration-none ms-1" data-clear="city">&times;</a></span>
                }
                @foreach (var c in cats)
                {
                    <span class="chip chip-blue">@c <a href="#" class="text-decoration-none ms-1" data-clearcat="@c">&times;</a></span>
                }
                @foreach (var s in subs)
                {
                    <span class="chip chip-gray">@s <a href="#" class="text-decoration-none ms-1" data-clearsub="@s">&times;</a></span>
                }
                @foreach (var h in q["habitIds"])
                {
                    var hid = int.TryParse(h, out var v) ? v : 0;
                    var habitName = "Habit";
                    foreach (var hb in habitsSel)
                    {
                        if ((int)hb.HabitId == hid) { habitName = (string)hb.Name; break; }
                    }
                    <span class="chip chip-green">@habitName <a href="#" class="text-decoration-none ms-1" data-clearhabit="@h">&times;</a></span>
                }
                <a href="@Url.Action("FindService")" class="small text-danger fw-semibold ms-1">Clear all</a>
            </div>
        }
    </div>
</div>

<p class="text-muted mb-3">@Model.Count worker(s) found.</p>

@if (!Model.Any())
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-search"></i>
            <h5 class="mt-3">No workers match your search</h5>
            <p>Try adjusting your filters.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var w in Model)
        {
            var pic = FypWeb.Helpers.ViewHelpers.Pic(w.Picture);
            <div class="col-md-6 col-xl-4">
                <div class="card-soft worker-card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="wc-top">
                            @if (pic != null)
                            {
                                <img src="@pic" class="wc-avatar" alt="@w.Name" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                                <div class="wc-avatar-fallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(w.Name)</div>
                            }
                            else
                            {
                                <div class="wc-avatar-fallback">@FypWeb.Helpers.ViewHelpers.Initial(w.Name)</div>
                            }
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold">@w.Name</span>
                                    @if (w.IsPoliceVerified)
                                    {
                                        <i class="bi bi-patch-check-fill text-brand" title="Police verified"></i>
                                    }
                                    @if (w.IsCompanyCertified)
                                    {
                                        <span class="chip chip-blue" style="font-size:11px;padding:2px 8px;" title="Company-trained / certified">
                                            <i class="bi bi-patch-check me-1"></i>Certified
                                        </span>
                                    }
                                </div>
                                <div class="text-muted small">@w.Role</div>
                                <div class="stars mt-1"><i class="bi bi-star-fill"></i> <span class="text-dark fw-semibold">@w.Rating</span></div>
                            </div>
                        </div>
                        <div class="mt-3 small text-muted">
                            <div><i class="bi bi-geo-alt me-1"></i>@w.City</div>
                            <div><i class="bi bi-cash-coin me-1"></i>@w.Salary</div>
                            <div><i class="bi bi-gender-ambiguous me-1"></i>@w.Gender</div>
                        </div>
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            @foreach (var c in w.Categories.Take(3))
                            {
                                <span class="chip chip-blue">@c</span>
                            }
                        </div>
                        <div class="mt-auto pt-3">
                            <a asp-action="WorkerDetail" asp-route-id="@w.Id" class="btn btn-primary w-100">View Profile</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-clear],[data-clearcat],[data-clearsub],[data-clearhabit]').forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    var p = new URLSearchParams(window.location.search);
                    if (this.hasAttribute('data-clear')) p.delete(this.getAttribute('data-clear'));
                    if (this.hasAttribute('data-clearcat')) {
                        var keep = p.getAll('categories').filter(function (c) { return c !== a.getAttribute('data-clearcat'); });
                        p.delete('categories'); keep.forEach(function (c) { p.append('categories', c); });
                    }
                    if (this.hasAttribute('data-clearsub')) {
                        var keepS = p.getAll('subSkills').filter(function (s) { return s !== a.getAttribute('data-clearsub'); });
                        p.delete('subSkills'); keepS.forEach(function (s) { p.append('subSkills', s); });
                    }
                    if (this.hasAttribute('data-clearhabit')) {
                        var keepH = p.getAll('habitIds').filter(function (h) { return h !== a.getAttribute('data-clearhabit'); });
                        p.delete('habitIds'); keepH.forEach(function (h) { p.append('habitIds', h); });
                    }
                    window.location.href = window.location.pathname + (p.toString() ? '?' + p.toString() : '');
                });
            });
        })();
    </script>
}