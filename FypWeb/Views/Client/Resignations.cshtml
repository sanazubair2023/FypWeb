@model List<ResignationVM>
@{
    ViewData["Title"] = "Resignations";
}

<div class="page-head">
    <h1>Resignations</h1>
    <p>Workers who have submitted a resignation request.</p>
</div>

@if (!Model.Any())
{
    <div class="card-soft"><div class="empty-state">
        <i class="bi bi-file-earmark-person"></i>
        <h5 class="mt-3">No resignations</h5>
        <p>You have no pending or past resignations.</p>
    </div></div>
}
else
{
    <div class="row g-3">
        @foreach (var r in Model)
        {
            var pic = FypWeb.Helpers.ViewHelpers.Pic(r.WorkerAvatar);
            var chip = r.Status switch
            {
                "Resigned" => "chip-gray",
                "ResignationPending" => "chip-amber",
                _ => "chip-blue"
            };
            <div class="col-md-6">
                <div class="card-soft"><div class="card-body">
                    <div class="d-flex gap-3">
                        @if (pic != null)
                        {
                            <img src="@pic" class="avatar-round" alt="@r.WorkerName" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                            <div class="avatar-round-fallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(r.WorkerName)</div>
                        }
                        else
                        {
                            <div class="avatar-round-fallback">@FypWeb.Helpers.ViewHelpers.Initial(r.WorkerName)</div>
                        }
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold">@r.WorkerName</span>
                                <span class="chip @chip">@(r.Status == "ResignationPending" ? "Pending" : r.Status)</span>
                            </div>
                            <div class="text-muted small mt-1"><i class="bi bi-calendar-x me-1"></i>Last day: @r.LastWorkingDate</div>
                            <div class="text-muted small">Submitted: @r.SubmittedDate</div>
                        </div>
                    </div>
                    <p class="mt-3 mb-2 small"><strong>Reason:</strong> @r.Reason</p>
                    <a asp-action="ResignationDetail" asp-route-id="@r.ResignationId" class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-eye me-1"></i>Review &amp; Respond
                    </a>
                </div></div>
            </div>
        }
    </div>
}
