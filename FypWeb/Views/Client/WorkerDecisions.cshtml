@model List<InterviewRequestVM>
@{
    ViewData["Title"] = "Hiring Decisions";
}

<div class="page-head">
    <h1>Hiring Decisions</h1>
    <p>Track your job offers. Finalize once the worker accepts the offer.</p>
</div>

@if (!Model.Any())
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-clipboard-check"></i>
            <h5 class="mt-3">No hiring in progress</h5>
            <p>Send a job offer from your Active Requests to get started.</p>
            <a asp-action="ActiveRequests" class="btn btn-primary">Active Requests</a>
        </div>
    </div>
}
else
{
    <div class="card-soft">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Worker</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Worker's Response</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var pic = FypWeb.Helpers.ViewHelpers.Pic(r.OtherPartyPicture);
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (pic != null)
                                        {
                                            <img src="@pic" class="avatar-sm" alt="@r.OtherPartyName" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                            <span class="avatar-fallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(r.OtherPartyName)</span>
                                        }
                                        else
                                        {
                                            <span class="avatar-fallback">@FypWeb.Helpers.ViewHelpers.Initial(r.OtherPartyName)</span>
                                        }
                                        <span class="fw-semibold">@r.OtherPartyName</span>
                                    </div>
                                </td>
                                <td class="small text-muted">@r.Location</td>
                                <td>
                                    <span class="chip chip-blue">@r.JobType</span>
                                    @if (r.IsExclusive && r.JobType == "Full-Time")
                                    {
                                        <div class="small fw-semibold mt-1" style="color:#9A3412;"><i class="bi bi-lock-fill me-1"></i>Exclusive full-time commitment</div>
                                    }
                                </td>
                                <td>
                                    @if (r.HiringWorkerDecision == "Accepted")
                                    {
                                        <span class="chip chip-green">Accepted</span>
                                    }
                                    else if (r.HiringWorkerDecision == "Rejected")
                                    {
                                        <span class="chip chip-red">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-amber">Awaiting</span>
                                    }
                                </td>
                                <td>
                                    @if (r.HiringDecision == "Accepted" || r.Status == "Finalized")
                                    {
                                        <span class="chip chip-green">Hired</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-gray">@(string.IsNullOrEmpty(r.Status) ? "Pending" : r.Status)</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (r.HiringWorkerDecision == "Accepted" && r.HiringDecision != "Accepted" && r.Status != "Finalized")
                                    {
                                        <form asp-action="FinalizeHiring" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="hiringId" value="@r.HiringId" />
                                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-all me-1"></i>Finalize Hire</button>
                                        </form>
                                    }
                                    else if (r.HiringDecision == "Accepted" || r.Status == "Finalized")
                                    {
                                        <span class="text-success small"><i class="bi bi-check-circle-fill"></i> Complete</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
