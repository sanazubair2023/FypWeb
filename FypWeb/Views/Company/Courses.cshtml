@model List<CourseCardVM>
@{
    ViewData["Title"] = "Course Management";
    string scope = ViewBag.Scope ?? "active";
}

<div class="page-head d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div>
        <h1>Course Management</h1>
        <p class="text-muted mb-0">Build skills. Certify achievement.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Directory" class="btn btn-outline-secondary btn-sm" title="Worker Directory"><i class="bi bi-people"></i></a>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm" title="Company Dashboard"><i class="bi bi-building"></i></a>
        <a asp-action="CourseForm" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Course</a>
    </div>
</div>

<div class="mb-3 d-inline-flex flex-wrap gap-1" style="background:#EEF2F7; border-radius:14px; padding:4px;">
    @foreach (var t in new[] { "active", "past", "archived" })
    {
        var active = scope == t;
        <a asp-action="Courses" asp-route-scope="@t"
           class="btn btn-sm @(active ? "btn-white shadow-sm fw-bold" : "btn-link text-decoration-none text-muted fw-semibold")"
           style="@(active ? "background:#fff;color:#1565C0;border-radius:11px;" : "border-radius:11px;")">
            @(t.Substring(0, 1).ToUpper() + t.Substring(1))
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="card-soft"><div class="empty-state">
        <i class="bi bi-book" style="color:#1565C0;"></i>
        <h5 class="mt-3">No @scope courses</h5>
        <p>Create a professional training course to get started.</p>
    </div></div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card-soft h-100"><div class="card-body d-flex flex-column">
                    <a asp-action="CourseDetail" asp-route-id="@c.CourseId" class="text-decoration-none d-flex align-items-center gap-3">
                        <div style="width:46px;height:46px;border-radius:13px;background:#EAF3FF;color:#1565C0;display:grid;place-items:center;font-size:1.25rem;flex:0 0 auto;">
                            <i class="bi bi-mortarboard"></i>
                        </div>
                        <div class="flex-grow-1 text-dark">
                            <div class="fw-bold">@c.CourseName</div>
                            <div class="small text-muted"><i class="bi bi-calendar-range me-1"></i>@c.StartDate — @c.EndDate</div>
                            <div class="small text-muted"><i class="bi bi-clock me-1"></i>@c.ClassTimings</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="small text-muted">@c.EnrollmentCount enrolled · @c.CompletedCount completed</span>
                        <form asp-action="DeleteCourse" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.CourseId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('@(c.EnrollmentCount > 0 ? "This course has enrollments and will be ARCHIVED (not deleted). Continue?" : "Permanently delete this course?")');">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div></div>
            </div>
        }
    </div>
}
