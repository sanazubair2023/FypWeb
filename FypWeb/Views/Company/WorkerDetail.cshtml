@model WorkerCertificateVM
@{
    ViewData["Title"] = "Certify Worker";
    var pic = FypWeb.Helpers.ViewHelpers.Pic(Model.Picture);
}

<a asp-action="Directory" class="btn btn-link px-0 mb-2 text-brand"><i class="bi bi-arrow-left me-1"></i>Back to directory</a>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card-soft"><div class="card-body text-center">
            @if (pic != null)
            {
                <img src="@pic" class="detail-avatar mb-3" alt="@Model.Name" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                <div class="detail-avatar-fallback mb-3 mx-auto" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(Model.Name)</div>
            }
            else
            {
                <div class="detail-avatar-fallback mb-3 mx-auto">@FypWeb.Helpers.ViewHelpers.Initial(Model.Name)</div>
            }
            <h4 class="fw-bold mb-1">@Model.Name</h4>
            <span class="chip chip-blue">@Model.RoleTitle</span>
            <hr />
            <ul class="list-unstyled text-start small mb-0">
                <li class="mb-2"><i class="bi bi-person-badge me-2 text-brand"></i>CNIC: @Model.Cnic</li>
                <li class="mb-2"><i class="bi bi-telephone me-2 text-brand"></i>@Model.Phone</li>
                <li><i class="bi bi-geo-alt me-2 text-brand"></i>@Model.Address</li>
            </ul>
        </div></div>
    </div>

    <div class="col-lg-7">
        @if (Model.HasCertificate)
        {
            <div class="card-soft mb-3 border-success"><div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-patch-check-fill text-success fs-4"></i>
                    <h6 class="fw-bold mb-0">Existing Certification</h6>
                </div>
                <div class="p-3 bg-light rounded">
                    <div class="fw-bold">@Model.CertificateTitle</div>
                    <div class="text-muted small mb-2">Issued: @Model.IssuedDate</div>
                    <div class="small">@Model.EvaluationNotes</div>
                </div>
                <p class="small text-muted mt-2 mb-0">Issuing a new certificate will add another record.</p>
            </div></div>
        }

        <div class="card-soft"><div class="card-body">
            <h6 class="fw-bold"><i class="bi bi-award me-1 text-brand"></i>Issue Skill Certificate</h6>
            <form asp-action="IssueCertificate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="workerId" value="@Model.WorkerId" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Certificate Title</label>
                    <input type="text" name="certificateTitle" class="form-control" placeholder="e.g. Certified Professional Cook" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Training / Evaluation Notes</label>
                    <textarea name="trainingEvaluationNotes" class="form-control" rows="4" placeholder="Summarise the training completed and evaluation results"></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-patch-check me-1"></i>Issue &amp; Publish Certificate</button>
            </form>
        </div></div>
    </div>
</div>
