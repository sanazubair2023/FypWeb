@model List<PoliceWorkerVM>
@{
    ViewData["Title"] = "Verification Portal";
    int total = ViewBag.TotalResults ?? 0;
    int certified = ViewBag.CertifiedCount ?? 0;
    int uncertified = ViewBag.UncertifiedCount ?? 0;
    string searchCnic = ViewBag.SearchCnic as string ?? "";
}

<div class="page-head">
    <h1>Character Verification Portal</h1>
    <p>Issue and renew police character certificates for domestic workers.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card-soft stat-card">
            <div class="stat-icon blue"><i class="bi bi-people-fill"></i></div>
            <div><div class="stat-num">@total</div><div class="stat-label">Total Workers</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card-soft stat-card">
            <div class="stat-icon green"><i class="bi bi-patch-check-fill"></i></div>
            <div><div class="stat-num">@certified</div><div class="stat-label">Verified</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card-soft stat-card">
            <div class="stat-icon amber"><i class="bi bi-exclamation-circle"></i></div>
            <div><div class="stat-num">@uncertified</div><div class="stat-label">Unverified</div></div>
        </div>
    </div>
</div>

<div class="card-soft mb-4">
    <div class="card-body">
        <form method="get" asp-action="Portal" class="row g-2">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchCnic" value="@searchCnic" class="form-control" placeholder="Search by CNIC" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
                <a asp-action="Portal" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card-soft">
        <div class="empty-state">
            <i class="bi bi-search"></i>
            <h5 class="mt-3">No workers found</h5>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var w in Model)
        {
            var pic = FypWeb.Helpers.ViewHelpers.Pic(w.Picture);
            <div class="col-md-6 col-xl-4">
                <div class="card-soft worker-card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="wc-top">
                            @if (pic != null)
                            {
                                <img src="@pic" class="wc-avatar" alt="@w.Name" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                                <div class="wc-avatar-fallback" style="display:none;">@FypWeb.Helpers.ViewHelpers.Initial(w.Name)</div>
                            }
                            else
                            {
                                <div class="wc-avatar-fallback">@FypWeb.Helpers.ViewHelpers.Initial(w.Name)</div>
                            }
                            <div>
                                <div class="fw-bold">@w.Name</div>
                                <div class="text-muted small">@w.Category</div>
                                <div class="text-muted small"><i class="bi bi-person-badge me-1"></i>@w.Cnic</div>
                            </div>
                        </div>
                        <div class="mt-3">
                            @if (w.IsCertified)
                            {
                                <span class="chip chip-green"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>
                                <div class="text-muted small mt-1">Valid until @w.CertExpiry</div>
                            }
                            else
                            {
                                <span class="chip chip-amber"><i class="bi bi-exclamation-circle me-1"></i>Not verified</span>
                            }
                        </div>
                        <div class="mt-auto pt-3">
                            <a asp-action="WorkerDetail" asp-route-id="@w.Id" class="btn btn-primary w-100">
                                <i class="bi bi-shield-check me-1"></i>@(w.IsCertified ? "View / Renew" : "Verify Now")
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
